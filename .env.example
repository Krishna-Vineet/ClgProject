# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
# Local web dev proxy target. Defaults to PORT, then 8787. Production uses
# Vercel rewrites instead of this proxy.
API_PORT=8787
# Upper bound on one request, in milliseconds. Also sent to Postgres as
# statement_timeout, so a stuck lock wait cannot hold a pool slot forever.
REQUEST_TIMEOUT_MS=20000
WEB_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
MOBILE_SCHEME=campusops
# Native mobile builds only: absolute API origin, no /api/v1 suffix.
# The browser review preview uses a same-origin proxy and leaves this unset.
EXPO_PUBLIC_API_URL=
CAMPUS_TIMEZONE=Asia/Kolkata
INSTITUTION_NAME=Your Institution
# Set true only behind a trusted proxy (Vercel/Neon/load balancer) that strips client-supplied forwarding headers.
TRUST_PROXY_HEADERS=false
# How many reverse-proxy hops to trust for X-Forwarded-For when the headers above
# are enabled. 1 for Vercel, 2 for Vercel -> load balancer. Ignored otherwise.
TRUSTED_PROXY_HOPS=1
# JSON logs are easier to ship to a hosted collector; false gives readable local lines.
LOG_JSON=true

# ── Neon PostgreSQL ────────────────────────────────────────────────────────
# Neon usually gives DATABASE_URL (direct) and DATABASE_URL_POOLED (pooled).
# API runtime prefers DATABASE_URL_POOLED; migrations prefer DATABASE_URL/DATABASE_DIRECT_URL.
DATABASE_URL=
DATABASE_URL_POOLED=
DATABASE_DIRECT_URL=
DB_POOL_MAX=5
# Apply pending SQL migrations before the API starts (default: on outside
# production, off in production). The runner is idempotent and advisory-locked.
# In production run `bun run db:migrate` as a deploy step against
# DATABASE_DIRECT_URL. A failed migration leaves a degraded instance answering
# /health/ready with 503 rather than crashing in a restart loop.
AUTO_MIGRATE=true
# Reserved. CampusOps currently uses its own auth; this is not consumed yet.
NEON_AUTH_BASE_URL=
# Disposable local test DB only. Never point at production.
TEST_DATABASE_URL=postgresql://campusops:campusops@127.0.0.1:55432/campusops_test

# ── Auth secrets (generate: openssl rand -hex 32) ──────────────────────────
JWT_ACCESS_SECRET=
REFRESH_TOKEN_PEPPER=
# An hour by default. The refresh token (30 days, rotated) bounds the session;
# this only controls how often the silent refresh has to happen.
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# ── Explicit demo toggles ──────────────────────────────────────────────────
# Local review defaults. Production demo requires ALLOW_PRODUCTION_DEMO=true.
DEMO_MODE=true
ALLOW_PRODUCTION_DEMO=false
# demo | brevo | resend. demo requires DEMO_MODE=true.
EMAIL_MODE=demo
# Show the 6-digit OTP in API/UI only in demo email mode.
EXPOSE_DEMO_OTP=true
# Enables seeded demo-account login. Never use a real password here.
SEED_DEMO_PASSWORD=

# ── Email ──────────────────────────────────────────────────────────────────
# Brevo free tier can use a verified single sender (no custom domain required).
EMAIL_FROM=CampusOps <your-verified-sender@gmail.com>
BREVO_API_KEY=
RESEND_API_KEY=
# Legacy fallback only; prefer provider-specific keys.
EMAIL_PROVIDER_API_KEY=

# ── Private S3-compatible object storage (Neon S3 / AWS S3 / R2) ───────────
# disabled | s3. Use s3 for real photo/ID/report/export storage.
STORAGE_MODE=disabled
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_BUCKET=
S3_SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES=5242880

# ── Phase 3: approvals, resource holds, notifications and jobs ─────────────
# How long a HELD resource reservation survives without an approval decision.
RESOURCE_HOLD_TTL_HOURS=72
# Queue approval/event notifications in the transactional outbox.
NOTIFICATIONS_ENABLED=true
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=5
# In-process job timer. Leave false on free/serverless hosts and use a cron
# hitting `bun run jobs:run` or POST /api/v1/admin/jobs/maintenance instead.
JOBS_ENABLED=false
JOB_INTERVAL_SECONDS=120
# Run due maintenance on the first authenticated admin read instead of waiting
# for the timer. Makes the in-app dashboard self-healing on free hosts.
MAINTENANCE_ON_REQUEST=true
# Cooldown between on-request maintenance runs, so a busy dashboard does not
# hammer the database.
MAINTENANCE_INTERVAL_SECONDS=120
# Shared secret for POST /api/v1/admin/jobs/maintenance when an external scheduler
# calls it. 32+ characters; leave empty to require an admin bearer token instead.
JOB_RUN_TOKEN=

# ── Phase 7: push notifications and offline scanning ───────────────────────
# disabled = no push (the in-app inbox still works).
# demo     = log deliveries instead of sending; requires DEMO_MODE=true.
# expo     = send through Expo's push service.
PUSH_MODE=disabled
# Optional Expo access token; raises rate limits and enables receipt checks.
EXPO_ACCESS_TOKEN=
# One account may register this many phones. Oldest is replaced beyond the cap.
PUSH_MAX_DEVICES_PER_USER=5
# Scans captured offline are refused if older than this when they sync.
OFFLINE_SCAN_MAX_AGE_MINUTES=180
# Max scans accepted in one sync request.
OFFLINE_SCAN_BATCH_MAX=50
# Tolerance for a phone clock running slightly ahead of the server.
OFFLINE_SCAN_GRACE_SECONDS=120

# ── Mobile app (public; embedded in the native bundle) ─────────────────────
# Absolute API origin for a physical phone / native build. Leave empty for the
# browser preview, which uses same-origin relative URLs through the proxy.
EXPO_PUBLIC_API_URL=


# --- Operational caps (previously literals in service code) ---
# Max recipients fanned out per notification when no specific user is targeted.
OUTBOX_FANOUT_MAX=50
# Max invitations returned for a single invited-only event.
INVITATION_LIST_MAX=500
# Max resource units scanned when computing availability for a window.
RESOURCE_AVAILABILITY_MAX_UNITS=200
# Max approvers returned by the approver directory.
APPROVER_DIRECTORY_MAX=200
# Max attendee rows embedded in one event report PDF.
REPORT_MAX_ATTENDEES=2000
# Rotating QR lifetime. Used by the mobile check-in phase.
QR_TTL_SECONDS=60
# Optional. Leave unset to derive the QR signing key from JWT_ACCESS_SECRET.
# Set a separate 32+ char value to rotate access QRs without ending sessions.
# QR_SIGNING_SECRET=
# Rate-limit ceiling multiplier. MUST stay 1 in production. Raise temporarily for
# a local test session or browser suite (many logins from one address).
RATE_LIMIT_SCALE=1
# Deep link printed inside complaint QR codes; the mobile app registers this scheme.
COMPLAINT_QR_BASE=campusops://complaint

# ── One-time production Admin bootstrap (never commit real values) ─────────
# Used only by `bun run admin:bootstrap`; refuses if an ADMIN already exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
