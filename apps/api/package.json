{
  "name": "@campusops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:check": "bun run src/db/check.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit",
    "jobs:run": "bun run src/jobs/run-once.ts",
    "admin:bootstrap": "bun run src/db/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@campusops/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "pdf-lib": "1.17.1",
    "postgres": "^3.4.5",
    "qrcode": "1.5.4",
    "zod": "^3.24.1",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.3"
  }
}
